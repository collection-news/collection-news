{
  "name": "collection-news",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "11.x"
  },
  "scripts": {
    "sitemap": "ts-node src/scripts/genSitemap.ts",
    "prebuild": "pnpm theme:types && pnpm run sitemap",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "pnpm theme:types && tsc -p tsconfig.test.json",
    "test:browser:build": "pnpm theme:types && node tests/support/build-app.mjs",
    "test:browser": "pnpm test:browser:build && playwright test --project=chromium",
    "test:browser:all": "pnpm test:browser:build && playwright test",
    "test:browser:dev": "playwright test --config=playwright.dev.config.ts",
    "test:live": "playwright test --config=playwright.live.config.ts",
    "setenv": "vercel env pull .env.local",
    "v": "vercel",
    "prepare": "pnpm theme:types && husky",
    "theme:types": "chakra typegen src/theme/index.ts",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1131.0",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/credential-provider-ini": "3.973.16",
    "@aws-sdk/lib-dynamodb": "3.1131.0",
    "@aws-sdk/util-dynamodb": "3.996.9",
    "@chakra-ui/react": "3.37.0",
    "@emotion/react": "11.14.0",
    "@fortedigital/nextjs-cache-handler": "^3.3.0",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@meilisearch/instant-meilisearch": "^0.30.0",
    "@next/mdx": "16.3.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "date-fns": "4.4.0",
    "dayjs": "1.11.23",
    "dotenv": "17.4.2",
    "immer": "11.1.18",
    "instantsearch.js": "4.116.0",
    "meilisearch": "^0.62.0",
    "next": "16.3.5",
    "ramda": "0.32.0",
    "randomcolor": "^0.6.2",
    "react": "19.3.0",
    "react-custom-scrollbars-next": "^1.0.1",
    "react-day-picker": "10.0.1",
    "react-div-100vh": "0.7.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "react-infinite-scroll-component": "7.2.1",
    "react-instantsearch": "^7.49.0",
    "react-instantsearch-router-nextjs": "^7.49.0",
    "react-intersection-observer": "^11.0.1",
    "react-responsive-carousel": "3.2.23",
    "react-schemaorg": "2.0.1",
    "react-use": "17.6.1",
    "sitemap": "9.0.1",
    "snappy": "7.4.3",
    "string-strip-html": "^13.7.3",
    "use-debounce": "^10.1.1",
    "usehooks-ts": "^3.1.1",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@chakra-ui/cli": "3.37.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mdx": "2.0.14",
    "@types/node": "24.13.4",
    "@types/ramda": "0.31.1",
    "@types/randomcolor": "^0.5.9",
    "@types/react": "19.3.0",
    "@types/react-custom-scrollbars": "4.0.13",
    "@vitest/coverage-v8": "5.0.0",
    "husky": "9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "17.5.1",
    "schema-dts": "2.0.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vercel": "59.16.0",
    "vitest": "5.0.0"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
